{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/run_agent.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "env": {
                "WORKSPACE": "${workspaceFolder}/.local/workspace",
                "INSTANCE_DIR": "${workspaceFolder}/.local/instance",
                "WORKBENCH": "cleankoda-workbench-local"
            }
        },
        {
            "name": "Python: Run Web",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "args": [
                "--app",
                "src/cleankoda/web",
                "run",
                "--debug",
                "--no-debugger",
                "--no-reload"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "env": {
                "WORKSPACE": "${workspaceFolder}/.local/workspace",
                "INSTANCE_DIR": "${workspaceFolder}/.local/instance",
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}